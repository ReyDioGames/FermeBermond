# ==========================================================================
# La Ferme Bermond — configuration Apache (OVH mutualisé)
# Chaque bloc est protégé par <IfModule> : si le module est absent sur le
# serveur, la règle est simplement ignorée, sans erreur 500.
# ==========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 1. Forcer HTTPS ---------------------------------------------------
    # Sur OVH, la terminaison SSL passe par un proxy : on teste les deux cas.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://lafermebermond.com/$1 [R=301,L]

    # --- 2. Forcer le domaine sans www (cohérent avec la balise canonical) --
    RewriteCond %{HTTP_HOST} ^www\.lafermebermond\.com$ [NC]
    RewriteRule ^(.*)$ https://lafermebermond.com/$1 [R=301,L]

    # --- 3. Anciennes URL en index.php -------------------------------------
    RewriteRule ^index\.php$ https://lafermebermond.com/ [R=301,L]
    RewriteRule ^index\.php/.*$ https://lafermebermond.com/ [R=301,L]

    # --- 4. Supprimer le /index.html final (URL canonique = racine) --------
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ https://lafermebermond.com/ [R=301,L]
</IfModule>

DirectoryIndex index.html index.php

# ==========================================================================
# Compression
# ==========================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ==========================================================================
# Cache navigateur
# ==========================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 1 hour"
    ExpiresByType text/xml                  "access plus 1 hour"
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 1 week"

    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
    ExpiresByType application/pdf           "access plus 1 month"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|gif|svg|ico|woff2?|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json|xml|webmanifest)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # --- Sécurité ---
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ==========================================================================
# Types MIME & encodage
# ==========================================================================
<IfModule mod_mime.c>
    AddType image/webp                  .webp
    AddType image/svg+xml               .svg
    AddType application/manifest+json   .webmanifest
    AddType application/ld+json         .jsonld
    AddType font/woff2                  .woff2
    AddCharset UTF-8 .html .css .js .json .xml .txt .webmanifest
</IfModule>

# ==========================================================================
# Divers
# ==========================================================================
# Interdire l'accès aux fichiers sensibles
<IfModule mod_authz_core.c>
    <FilesMatch "^(code\.txt|.*\.htaccess|redirect\.htaccess|.*\.log|\.git.*)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Pas de listing de répertoire
Options -Indexes
